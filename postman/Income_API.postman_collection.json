                  "pm.test('Only draft message', () => pm.expect(body.detail).to.include('Only draft income'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/clients/{{clientId}}/income/{{APPROVED_INCOME_ID}}",
            "description": "Replace APPROVED_INCOME_ID. Expected 422 — only DRAFT can be deleted."
          }
        }
      ]
    },
    {
      "name": "Validation Failures",
      "item": [
        {
          "name": "Missing required fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('Validation Failed', () => pm.expect(body.title).to.eql('Validation Failed'));",
                  "pm.test('Has errors map', () => pm.expect(body.errors).to.be.an('object'));",
                  "pm.test('transactionDate error', () => pm.expect(body.errors).to.have.property('transactionDate'));",
                  "pm.test('categoryId error', () => pm.expect(body.errors).to.have.property('categoryId'));",
                  "pm.test('amount error', () => pm.expect(body.errors).to.have.property('amount'));",
                  "pm.test('customerName error', () => pm.expect(body.errors).to.have.property('customerName'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/v1/clients/{{clientId}}/income",
            "description": "Empty body → 400 with field errors for transactionDate, categoryId, amount, customerName."
