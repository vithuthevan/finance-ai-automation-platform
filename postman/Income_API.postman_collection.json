              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/clients/{{clientId}}/income/{{incomeId}}",
            "description": "Re-delete same id after happy-path delete → 404."
          }
        },
        {
          "name": "Delete Income — APPROVED (business rule)",
          "event": [
