        {
          "name": "EXPENSE-only category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('Validation Failed', () => pm.expect(body.title).to.eql('Validation Failed'));",
                  "pm.test('categoryId field error', () => {",
                  "  pm.expect(body.errors).to.have.property('categoryId');",
                  "  pm.expect(body.errors.categoryId).to.include('not valid for income');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionDate\": \"2026-07-10\",\n  \"categoryId\": \"{{EXPENSE_CATEGORY_UUID}}\",\n  \"amount\": 100.00,\n  \"customerName\": \"Acme Corp\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clients/{{clientId}}/income",
            "description": "Set EXPENSE_CATEGORY_UUID to an EXPENSE-only category. Expected 400 with errors.categoryId."
          }
        },
        {
          "name": "Update with invalid amount",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('amount error', () => pm.expect(body.errors).to.have.property('amount'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionDate\": \"2026-07-11\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"amount\": -5,\n  \"customerName\": \"Acme Corp\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clients/{{clientId}}/income/{{incomeId}}",
            "description": "Negative amount on update → 400. Create a DRAFT income first."
          }
        }
      ]
    }
  ]
