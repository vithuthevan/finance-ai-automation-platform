# Copy to .env and replace placeholders. Never commit .env or real secrets.

# ---------------------------------------------------------------------------
# PostgreSQL (Compose service + local tools)
# ---------------------------------------------------------------------------
POSTGRES_DB=finance_platform
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Spring datasource
# Local Gradle: use localhost. Compose overrides this to postgres:5432.
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finance_platform
SPRING_DATASOURCE_USERNAME=finance_user
SPRING_DATASOURCE_PASSWORD=change-me

# ---------------------------------------------------------------------------
# JWT signing secret (required in production / Compose prod profile)
# Generate a unique value of at least 32 bytes, then base64-encode it.
# ---------------------------------------------------------------------------
APP_JWT_SECRET=replace-with-secure-secret

# ---------------------------------------------------------------------------
# CORS — explicit browser origins for separate-host frontend.
# Leave empty for same-origin Nginx. Never set * with credentialed JWT.
# ---------------------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------------
# Document storage
# local = filesystem (dev / Compose volume). Production should use s3.
# ---------------------------------------------------------------------------
APP_STORAGE_PROVIDER=local
STORAGE_PROVIDER=local
APP_STORAGE_LOCAL_ROOT=./data/storage
STORAGE_LOCAL_PATH=./data/storage
APP_STORAGE_MAX_BYTES=15728640
DOCUMENT_MAX_FILE_SIZE_MB=15
APP_STORAGE_S3_BUCKET=
APP_STORAGE_S3_REGION=ap-south-1
APP_STORAGE_S3_ENDPOINT=
APP_STORAGE_S3_ACCESS_KEY=
APP_STORAGE_S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Optional AI extraction. Disabled = manual review still works.
# ---------------------------------------------------------------------------
APP_AI_ENABLED=false
APP_AI_PROVIDER=disabled
APP_AI_API_KEY=
APP_AI_BASE_URL=https://api.openai.com/v1
APP_AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Email: log (default) or smtp. SMTP adapter is optional.
# ---------------------------------------------------------------------------
APP_EMAIL_PROVIDER=log
# OpenAPI / Swagger (disabled in production by default)
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
