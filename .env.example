# Copy to .env and fill in values. Never commit .env.
# Production: docker compose -f docker-compose.prod.yml --env-file .env up --build -d

# -----------------------------------------------------------------------------
# Spring profile (required in production compose)
# -----------------------------------------------------------------------------
# Active Spring profile. Production compose sets prod explicitly; dev compose defaults to dev.
SPRING_PROFILES_ACTIVE=prod

# -----------------------------------------------------------------------------
# PostgreSQL (required in production)
# -----------------------------------------------------------------------------
# Database name created by the postgres service / managed instance.
POSTGRES_DB=finance_platform
# Database user. Must match SPRING_DATASOURCE_USERNAME in production.
POSTGRES_USER=
# Strong database password. Must match SPRING_DATASOURCE_PASSWORD in production.
POSTGRES_PASSWORD=

# JDBC URL for the backend. Production compose builds this from POSTGRES_* when using bundled Postgres.
# For managed Postgres, set the full URL here and point SPRING_DATASOURCE_* at the same credentials.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/finance_platform
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# -----------------------------------------------------------------------------
# JWT authentication (required in production)
# -----------------------------------------------------------------------------
# HMAC signing secret for access tokens. Generate with: openssl rand -base64 48
# Must be at least 32 characters. No dev defaults are accepted in the prod profile.
APP_JWT_SECRET=
# Access token lifetime in milliseconds (default: 1 hour).
APP_JWT_EXPIRATION_MS=3600000
# JWT issuer claim.
APP_JWT_ISSUER=finance-platform

# -----------------------------------------------------------------------------
# Auth cookies
# -----------------------------------------------------------------------------
# Set true when the app is served over HTTPS so refresh cookies are Secure.
APP_AUTH_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated allowed browser origins for cross-origin deployments (Model B).
# Leave empty for same-origin reverse-proxy deployments (Model A).
APP_CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Public frontend URL (required in production)
# -----------------------------------------------------------------------------
# Canonical HTTPS origin used in password-reset and notification email links.
APP_FRONTEND_BASE_URL=https://your.domain.com

# -----------------------------------------------------------------------------
# Document storage
# -----------------------------------------------------------------------------
# Storage backend: local (Compose volume) or s3 (recommended for real production).
APP_STORAGE_PROVIDER=s3
# Local upload path inside the backend container when APP_STORAGE_PROVIDER=local.
APP_STORAGE_LOCAL_ROOT=/data/uploads
# S3 bucket name (required when APP_STORAGE_PROVIDER=s3).
APP_STORAGE_S3_BUCKET=
# AWS region or compatible object-store region.
APP_STORAGE_S3_REGION=ap-south-1
# Optional custom S3 endpoint for MinIO/Wasabi/etc. Leave empty for AWS.
APP_STORAGE_S3_ENDPOINT=
# Object storage access key (required when APP_STORAGE_PROVIDER=s3).
APP_STORAGE_S3_ACCESS_KEY=
# Object storage secret key (required when APP_STORAGE_PROVIDER=s3).
APP_STORAGE_S3_SECRET_KEY=

# -----------------------------------------------------------------------------
# Email (APP_EMAIL_PROVIDER required in production)
# -----------------------------------------------------------------------------
# Email delivery mode: log (stdout only) or smtp (real delivery).
APP_EMAIL_PROVIDER=smtp
# SMTP server hostname (required when APP_EMAIL_PROVIDER=smtp).
MAIL_HOST=
# SMTP port (587 for STARTTLS is typical).
MAIL_PORT=587
# SMTP username (required when APP_EMAIL_PROVIDER=smtp).
MAIL_USERNAME=
# SMTP password (required when APP_EMAIL_PROVIDER=smtp).
MAIL_PASSWORD=
# From address for outbound mail (required when APP_EMAIL_PROVIDER=smtp).
MAIL_FROM=
# Enable TLS for SMTP (true/false).
MAIL_TLS=true

# -----------------------------------------------------------------------------
# AI extraction (optional)
# -----------------------------------------------------------------------------
APP_AI_ENABLED=false
APP_AI_PROVIDER=disabled
APP_AI_API_KEY=

# -----------------------------------------------------------------------------
# Platform bootstrap (optional - remove after first platform admin grant)
# -----------------------------------------------------------------------------
# Grants platform-admin to an existing user email on first startup only.
APP_PLATFORM_ADMIN_BOOTSTRAP_EMAIL=

# -----------------------------------------------------------------------------
# API documentation (keep disabled in production)
# -----------------------------------------------------------------------------
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
