[Unit]
Description=Alert when Finance Platform backup fails
Documentation=file:///opt/finance-ai-automation-platform/BACKUP_RECOVERY_IMPLEMENTATION.md

[Service]
Type=oneshot
SyslogIdentifier=finance-platform-backup
ExecStart=/bin/logger -t finance-platform-backup -p user.err "BACKUP_RUN_FAILED event=backup_failed source=systemd-onfailure"
