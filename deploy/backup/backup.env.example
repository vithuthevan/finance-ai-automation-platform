# Backup configuration — copy to backup.env on the production host.
# Do NOT commit backup.env (contains or references secrets).
#
# Usage:
#   cp deploy/backup/backup.env.example deploy/backup/backup.env

# --- Application paths (on the VPS) ---
# Leave APP_ROOT unset to use the repository root (detected from this script).
# APP_ROOT=/opt/finance-ai-automation-platform
COMPOSE_FILE=docker-compose.prod.yml
ENV_FILE=.env

# --- Local backup destination (on VPS disk, outside containers) ---
BACKUP_ROOT=/var/backups/finance-platform
BACKUP_LOG_DIR=/var/log/finance-platform
# Abort if fewer than this many KB are free (default 1 GiB)
BACKUP_MIN_FREE_KB=1048576

# --- PostgreSQL ---
# Credentials are read from ENV_FILE (POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD).
# Override only if running backups outside Compose:
# POSTGRES_CONTAINER=finance-ai-automation-platform-postgres-1

# --- Document storage (local provider only) ---
# Set to true when APP_STORAGE_PROVIDER=local in .env
BACKUP_LOCAL_DOCUMENTS=true
# Docker volume name. Use "auto" (or leave unset) to resolve finance_uploads from Compose.
DOCUMENTS_VOLUME=auto

# --- Retention (local on-server copies) ---
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=3

# --- Off-server sync (required after go-live; on-VPS copies are not enough) ---
# Set BACKUP_OFFSITE_ENABLED=true after configuring one method below.
BACKUP_OFFSITE_ENABLED=false

# Method A: AWS CLI / S3-compatible (aws s3 sync)
BACKUP_S3_URI=s3://your-backup-bucket/finance-platform/
# Uses standard AWS env vars or ~/.aws/credentials:
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION
# For S3-compatible endpoints (MinIO, Backblaze B2, Wasabi, etc.):
# AWS_ENDPOINT_URL=https://s3.example.com
# Server-side encryption. Set to none for providers that reject --sse:
BACKUP_S3_SSE=AES256

# Method B: rclone
# RCLONE_REMOTE=backup-remote:finance-platform

# --- Restore safeguards (used by restore-postgres.sh) ---
# Production database name — restore script refuses a different target unless overridden
EXPECTED_DB_NAME=finance_platform
